<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Winning line highlight (selected state) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_secondary" />
            <corners android:radius="@dimen/radius_14" />
        </shape>
    </item>

    <!-- Press feedback -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_cell_bg_pressed" />
            <corners android:radius="@dimen/radius_14" />
            <stroke android:width="1dp" android:color="@color/ocean_border" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_cell_bg" />
            <corners android:radius="@dimen/radius_14" />
            <stroke android:width="1dp" android:color="@color/ocean_border" />
        </shape>
    </item>
</selector>
